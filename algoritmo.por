programa {
  funcao inicio() {
    inteiro n1, n2, soma
    escreva("Me diga 2 numeros para eu fazer uma soma.\n")
    leia(numero1)
    escreva("Agora me diga o segundo numero.\n")
    leia(numero2)
    soma = numero1 + numero2
    escreva("O resultado de ",numero1," + ", numero2, " = ", soma)
  }
}

